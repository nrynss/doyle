SCREENS = {
    ("1", "lookup"): ("LOOKUP", LOOKUP_V1),
    ("2", "lookup"): ("LOOKUP", LOOKUP_V2),
    ("1", "decommission"): ("DECOMMISSION", DECOMM_V1),
    ("2", "decommission"): ("DECOMMISSION", DECOMM_V2),
}


def print_screen(name, version, lines):
    print("SCREEN: %s (fern console v%s)" % (name, version))
    for line in lines:
        print(line)


def record_result(text):
    """Best-effort note of the last outcome for the operator. Ignored on failure."""
    try:
        here = os.path.dirname(os.path.abspath(__file__))
        rundir = os.path.normpath(os.path.join(here, "..", ".run"))
        os.makedirs(rundir, exist_ok=True)
        with open(os.path.join(rundir, "console-last-result"), "w") as f:
            f.write(text + "\n")
    except OSError:
        pass


def service_url(host, port, path):
    return "http://%s:%d%s" % (host, port, path)


def get_count(host, port):
    with urllib.request.urlopen(service_url(host, port, "/stats"), timeout=10) as r:
        return json.load(r)["patient_count"]


def post_decommission(host, port):
    body = json.dumps({"confirmation_token": CONFIRMATION_TOKEN}).encode("utf-8")
    req = urllib.request.Request(
        service_url(host, port, "/admin/decommission"),
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)


def cmd_lookup(version, args):
    name, lines = SCREENS[(version, "lookup")]
    print_screen(name, version, lines)
    if args.id != ACCOUNT_ID:
        result = "RESULT: REFUSED unknown account %s (console holds %s)" % (
            args.id,
            ACCOUNT_ID,
        )
        print(result)
        record_result(result)
        return 2
    result = "RESULT: LOOKUP %s RECORD FOUND" % args.id
    print(result)
    record_result(result)
    return 0


def cmd_decommission(version, args):
    name, lines = SCREENS[(version, "decommission")]
    print_screen(name, version, lines)
    if args.key != "PF12":
        result = "RESULT: REFUSED unknown key %s (press PF12)" % args.key
        print(result)
        record_result(result)
        return 2
    if version == "1":
        if not args.clinic:
            result = (
                "RESULT: REFUSED type the clinic name to confirm, "
                'then PF12 CONFIRM (--clinic "%s")' % CLINIC_NAME
            )
            print(result)
            record_result(result)
            return 2
        if args.clinic != CLINIC_NAME:
            result = "RESULT: REFUSED clinic name %s does not match" % args.clinic
            print(result)
            record_result(result)
            return 2
    try:
        post_decommission(args.host, args.port)
        count = get_count(args.host, args.port)
    except Exception as e:
        result = "RESULT: ERROR old records service unreachable: %s" % e
        print(result)
        record_result(result)
        return 1
    result = "RESULT: DECOMMISSIONED old patient_count: %d" % count
    print(result)
    record_result(result)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Fernwhistle operator console (v1 with confirmation, v2 without)."
    )
    parser.add_argument("--version", required=True, choices=("1", "2"))
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument(
        "--port",
        type=int,
        default=int(os.environ.get("OLD_SERVICE_PORT", DEFAULT_PORT)),
    )
    sub = parser.add_subparsers(dest="screen", required=True)
    p_lookup = sub.add_parser("lookup", help="open the LOOKUP screen")
    p_lookup.add_argument("--id", default=ACCOUNT_ID)
    p_decomm = sub.add_parser("decommission", help="open the DECOMMISSION screen")
    p_decomm.add_argument("--clinic", default=None)
    p_decomm.add_argument("--key", default="PF12")
    args = parser.parse_args(argv)
    if args.screen == "lookup":
        return cmd_lookup(args.version, args)
    return cmd_decommission(args.version, args)


if __name__ == "__main__":
    sys.exit(main())
